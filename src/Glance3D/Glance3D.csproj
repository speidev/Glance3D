<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop host: an OpenTK window, desktop OpenGL 3.3, and the command line. All viewer
       logic lives in Glance3D.Core and is shared with the web host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Glance3D</RootNamespace>
    <AssemblyName>glance3d</AssemblyName>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glance3D.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glance3D.Core\Glance3D.Core.csproj" />
  </ItemGroup>

</Project>
